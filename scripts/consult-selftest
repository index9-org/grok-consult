#!/usr/bin/env bash
# consult-selftest — no live model calls. Does not need `claude`, `codex`, or `cursor-agent` on PATH.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
TO="$ROOT/consult-timeout"
CL="$ROOT/claude-consult"
CX="$ROOT/codex-consult"
CU="$ROOT/cursor-consult"
TEST_TMP="$(mktemp -d "${TMPDIR:-/tmp}/consult-selftest.XXXXXX")"
ERR="$TEST_TMP/err"
fail=0

ok() { printf 'ok  %s\n' "$*"; }
bad() { printf 'FAIL %s\n' "$*" >&2; fail=1; }
cleanup() { rm -rf "$TEST_TMP"; }
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

[[ -x "$TO" && -x "$CL" && -x "$CX" && -x "$CU" ]] || { echo "missing executables" >&2; exit 1; }
bash -n "$CL" && bash -n "$CX" && bash -n "$CU"

set +e
"$TO" 1 -- /bin/sleep 5 >/dev/null 2>"$ERR"
rc=$?
set -e
if [[ $rc -eq 124 ]]; then
  ok "timeout 1s on sleep 5 → 124"
else
  bad "timeout rc=$rc (want 124)"
fi

set +e
"$TO" nan -- /bin/echo hi >/dev/null 2>"$ERR"
rc=$?
set -e
if [[ $rc -eq 2 ]]; then
  ok "nan timeout rejected"
else
  bad "nan rc=$rc (want 2)"
fi

child_of() {
  local parent="$1"
  ps -axo pid=,ppid= | awk -v parent="$parent" '$2 == parent { print $1; exit }'
}

# Parent bash does not exec the helper. SIGKILL the bash so it cannot
# forward signals; the helper must reap its exact child via ppid polling.
# `; exit` keeps bash as parent (bash -c otherwise execs a single command).
bash -c '"$1" 30 -- /bin/sleep 31; exit' x "$TO" &
bp=$!
sleep 0.4
hpid="$(child_of "$bp" || true)"
spid=""
[[ -z "$hpid" ]] || spid="$(child_of "$hpid" || true)"
if ! kill -0 "$bp" 2>/dev/null; then
  bad "parent bash exited before kill"
elif [[ -z "$spid" ]]; then
  kill -KILL "$bp" 2>/dev/null || true
  wait "$bp" 2>/dev/null || true
  bad "could not find timeout child"
else
  kill -KILL "$bp" 2>/dev/null || true
  wait "$bp" 2>/dev/null || true
  sleep 5
  if kill -0 "$spid" 2>/dev/null; then
    bad "timeout child (pid $spid) still running after parent SIGKILL"
    kill -KILL "$spid" 2>/dev/null || true
  else
    ok "parent death reaped sleep child"
  fi
fi

# The session leader exits on SIGINT while its child ignores SIGINT/SIGTERM.
# Escalation must continue until the entire process group is gone.
"$TO" 1 -- python3 -c '
import signal
import subprocess
import sys
import time

subprocess.Popen([
    sys.executable,
    "-c",
    "import signal,time; signal.signal(signal.SIGINT, signal.SIG_IGN); signal.signal(signal.SIGTERM, signal.SIG_IGN); time.sleep(30)",
])
signal.signal(signal.SIGINT, lambda *_: sys.exit(0))
time.sleep(30)
' >/dev/null 2>"$ERR" &
tp=$!
sleep 0.4
leader_pid="$(child_of "$tp" || true)"
leaf_pid=""
[[ -z "$leader_pid" ]] || leaf_pid="$(child_of "$leader_pid" || true)"
set +e
wait "$tp"
rc=$?
set -e
if [[ $rc -ne 124 ]]; then
  bad "process-group timeout rc=$rc (want 124)"
elif [[ -z "$leaf_pid" ]]; then
  bad "could not find process-group probe child"
elif kill -0 "$leaf_pid" 2>/dev/null; then
  bad "process-group child (pid $leaf_pid) survived escalation"
  kill -KILL "$leaf_pid" 2>/dev/null || true
else
  ok "timeout reaped full process group"
fi

# Session leader exits 0 while a child remains. Reap the group; keep rc 0.
export LEAF_PID_FILE="$TEST_TMP/leaf.pid"
set +e
"$TO" 10 -- python3 -c '
import os
import subprocess
import sys

p = subprocess.Popen([sys.executable, "-c", "import time; time.sleep(20)"])
open(os.environ["LEAF_PID_FILE"], "w").write(str(p.pid))
raise SystemExit(0)
' >/dev/null 2>"$ERR"
rc=$?
set -e
unset LEAF_PID_FILE
leaf_pid="$(cat "$TEST_TMP/leaf.pid" 2>/dev/null || true)"
if [[ $rc -ne 0 ]]; then
  bad "leader-exit leftover rc=$rc (want 0)"
elif [[ -z "$leaf_pid" ]]; then
  bad "leader-exit leftover did not record child pid"
elif kill -0 "$leaf_pid" 2>/dev/null; then
  bad "leader-exit leftover (pid $leaf_pid) survived"
  kill -KILL "$leaf_pid" 2>/dev/null || true
else
  ok "leader exit reaped leftover process group"
fi

# A timed-out Codex run must preserve a completed answer while returning 124.
mkdir -p "$TEST_TMP/bin"
cat >"$TEST_TMP/bin/codex" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
last=""
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "-o" ]]; then
    last="$2"
    shift 2
  else
    shift
  fi
done
cat >/dev/null
printf 'answer before timeout\n' >"$last"
/bin/sleep 30
EOF
chmod +x "$TEST_TMP/bin/codex"
set +e
answer="$(PATH="$TEST_TMP/bin:$PATH" "$CX" --mode opinion --timeout 1 --stdin <<<"test" 2>"$ERR")"
rc=$?
set -e
if [[ $rc -eq 124 && "$answer" == "answer before timeout" ]]; then
  ok "codex timeout preserved answer and returned 124"
else
  bad "codex timeout rc=$rc answer=$(printf %q "$answer")"
fi

expect2() {
  local label="$1"
  shift
  set +e
  "$@" >/dev/null 2>"$ERR"
  rc=$?
  set -e
  if [[ $rc -eq 2 ]]; then
    ok "$label"
  else
    bad "$label rc=$rc (want 2) $(head -c 200 "$ERR")"
  fi
}

expect2_stdin() {
  local label="$1"
  local input="$2"
  shift 2
  set +e
  "$@" <<<"$input" >/dev/null 2>"$ERR"
  rc=$?
  set -e
  if [[ $rc -eq 2 ]]; then
    ok "$label"
  else
    bad "$label rc=$rc (want 2) $(head -c 200 "$ERR")"
  fi
}

expect2 "claude refuses --bare" "$CL" --bare --mode opinion -- x
expect2_stdin "claude refuses \$HOME cwd" x "$CL" --mode opinion --cwd "$HOME" --stdin
expect2_stdin "claude refuses ~/.grok cwd" x "$CL" --mode opinion --cwd "$HOME/.grok" --stdin
expect2_stdin "claude empty prompt" "" "$CL" --mode opinion --stdin
expect2_stdin "claude review empty prompt" "" "$CL" --mode review --cwd "$TEST_TMP" --stdin
expect2 "claude argv prompt removed" "$CL" --mode opinion -- x
expect2_stdin "claude review needs cwd" x "$CL" --mode review --stdin
expect2 "claude raw removed" "$CL" --mode raw
expect2 "claude --json-full removed" "$CL" --mode opinion --json-full -- x
expect2 "claude --no-timeout removed" "$CL" --mode opinion --no-timeout -- x
expect2 "claude --permission-mode removed" "$CL" --mode opinion --permission-mode auto -- x
expect2_stdin "codex refuses \$HOME cwd" x "$CX" --mode read --cwd "$HOME" --stdin
expect2_stdin "codex refuses ~/.grok cwd" x "$CX" --mode read --cwd "$HOME/.grok" --stdin
expect2_stdin "codex review needs cwd" x "$CX" --mode review --stdin
expect2 "codex review target needs review mode" "$CX" --mode read --base main
expect2 "codex review title needs review mode" "$CX" --mode implement --title test
expect2 "codex argv prompt removed" "$CX" --mode opinion -- x
expect2 "codex raw removed" "$CX" --mode raw
expect2 "codex --json removed" "$CX" --mode opinion --json -- "x"
expect2 "codex --add-dir removed" "$CX" --mode opinion --add-dir /tmp -- "x"
expect2 "codex --skip-git-check removed" "$CX" --mode opinion --skip-git-check -- "x"
expect2 "codex --no-timeout removed" "$CX" --mode opinion --no-timeout -- "x"
expect2_stdin "cursor refuses \$HOME cwd" x "$CU" --mode opinion --cwd "$HOME" --stdin
expect2_stdin "cursor refuses ~/.grok cwd" x "$CU" --mode opinion --cwd "$HOME/.grok" --stdin
expect2_stdin "cursor empty prompt" "" "$CU" --mode opinion --stdin
expect2_stdin "cursor review empty prompt" "" "$CU" --mode review --cwd "$TEST_TMP" --stdin
expect2 "cursor argv prompt removed" "$CU" --mode opinion -- x
expect2_stdin "cursor review needs cwd" x "$CU" --mode review --stdin
expect2 "cursor raw removed" "$CU" --mode raw
expect2 "cursor --force removed" "$CU" --mode opinion --force -- x
expect2 "cursor --yolo removed" "$CU" --mode opinion --yolo -- x
expect2 "cursor --effort points at model id" "$CU" --mode opinion --effort high -- x
expect2 "cursor --approve-mcps removed" "$CU" --mode opinion --approve-mcps -- x
expect2 "cursor --no-timeout removed" "$CU" --mode opinion --no-timeout -- x

mkdir -p "$TEST_TMP/bin" "$TEST_TMP/repo"
cat >"$TEST_TMP/bin/cursor-agent" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "status" ]]; then
  printf '%s\n' '{"isAuthenticated": true}'
  exit 0
fi
if [[ -n "${CURSOR_ARGS_FILE:-}" ]]; then
  printf '%s\n' "$*" >"$CURSOR_ARGS_FILE"
fi
cat
EOF
chmod +x "$TEST_TMP/bin/cursor-agent"

args_has() {
  local file="$1"
  local needle="$2"
  grep -F -q -- "$needle" "$file"
}

run_cursor() {
  local args_file="$1"
  shift
  CURSOR_ARGS_FILE="$args_file" PATH="$TEST_TMP/bin:$PATH" "$@"
}

mkdir -p "$TEST_TMP/bin-timeout"
cat >"$TEST_TMP/bin-timeout/cursor-agent" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if [[ "${1:-}" == "status" ]]; then
  printf '%s\n' '{"isAuthenticated": true}'
  exit 0
fi
cat
sleep 30
EOF
chmod +x "$TEST_TMP/bin-timeout/cursor-agent"
set +e
answer="$(PATH="$TEST_TMP/bin-timeout:$PATH" "$CU" --mode opinion --timeout 1 --stdin <<<"test" 2>"$ERR")"
rc=$?
set -e
if [[ $rc -eq 124 && "$answer" == *test* ]]; then
  ok "cursor timeout preserved stdin answer and returned 124"
else
  bad "cursor timeout rc=$rc answer=$(printf %q "$answer")"
fi

space_dir="$TEST_TMP/repo with spaces"
mkdir -p "$space_dir"
space_abs="$(cd "$space_dir" && pwd -P)"

opinion_args="$TEST_TMP/opinion.args"
set +e
run_cursor "$opinion_args" "$CU" --mode opinion --stdin <<<"hello" >/dev/null 2>"$ERR"
rc=$?
set -e
if [[ $rc -ne 0 ]]; then
  bad "cursor opinion spawn rc=$rc $(head -c 200 "$ERR")"
elif args_has "$opinion_args" "--force"; then
  bad "cursor opinion passed --force"
elif ! args_has "$opinion_args" "--mode ask"; then
  bad "cursor opinion missing --mode ask"
elif ! args_has "$opinion_args" "--sandbox enabled"; then
  bad "cursor opinion missing --sandbox enabled"
elif ! args_has "$opinion_args" "--trust"; then
  bad "cursor opinion missing --trust"
elif args_has "$opinion_args" "--model"; then
  bad "cursor opinion passed --model without request"
else
  ok "cursor opinion flags: ask, sandbox, trust, no --force, no --model"
fi

impl_args="$TEST_TMP/impl.args"
set +e
run_cursor "$impl_args" "$CU" --mode implement --cwd "$space_dir" --model "claude-opus-5[effort=high]" --stdin <<<"hello" >/dev/null 2>"$ERR"
rc=$?
set -e
if [[ $rc -ne 0 ]]; then
  bad "cursor implement spawn rc=$rc $(head -c 200 "$ERR")"
elif ! args_has "$impl_args" "--force"; then
  bad "cursor implement missing --force"
elif args_has "$impl_args" "--mode ask"; then
  bad "cursor implement passed --mode ask"
elif args_has "$impl_args" "--sandbox"; then
  bad "cursor implement passed --sandbox"
elif ! args_has "$impl_args" "--model claude-opus-5[effort=high]"; then
  bad "cursor implement dropped bracket --model ($(cat "$impl_args"))"
elif ! args_has "$impl_args" "--workspace $space_abs"; then
  bad "cursor implement workspace mismatch ($(cat "$impl_args"))"
else
  ok "cursor implement flags: --force, no --mode, quoted bracket model, spaced cwd"
fi

review_args="$TEST_TMP/review.args"
set +e
run_cursor "$review_args" "$CU" --mode review --cwd "$TEST_TMP/repo" --stdin <<<"diff" >/dev/null 2>"$ERR"
rc=$?
set -e
if [[ $rc -ne 0 ]]; then
  bad "cursor review spawn rc=$rc $(head -c 200 "$ERR")"
elif args_has "$review_args" "--force"; then
  bad "cursor review passed --force"
elif ! args_has "$review_args" "--mode ask"; then
  bad "cursor review missing --mode ask"
else
  ok "cursor review flags: ask, no --force"
fi

if [[ $fail -ne 0 ]]; then
  echo "consult-selftest: FAILED" >&2
  exit 1
fi
echo "consult-selftest: ok"
